<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
IgnorableNamespaces="uap rescap">
  <!-- ProcessorArchitecture must match the executable. Without it the package registers as
       "neutral", and on an ARM64 machine Windows then resolves the arm64 WindowsAppRuntime
       framework for this x64 binary - the app dies at startup with 0x800700C1
       (ERROR_BAD_EXE_FORMAT) before it can report anything. -->
  <Identity Name="TargetedLaunch.Matrix.Responder" Publisher="CN=TargetedLaunchFixture"
            ProcessorArchitecture="x64" Version="1.0.0.0" />
  <Properties><DisplayName>TargetedLaunch Matrix Responder</DisplayName>
    <PublisherDisplayName>TargetedLaunch Fixture</PublisherDisplayName>
    <Description>Launch and respond security fixture</Description>
    <Logo>Assets\StoreLogo.png</Logo></Properties>
  <Resources><Resource Language="en-us" /></Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop"
        MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
    <PackageDependency Name="Microsoft.WindowsAppRuntime.1.6"
        Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US"
        MinVersion="6000.519.329.0" />
  </Dependencies>
  <Capabilities><rescap:Capability Name="runFullTrust" /></Capabilities>
  <Applications>
    <Application Id="Responder" Executable="LaunchResponseSample.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements AppListEntry="none" DisplayName="Matrix Responder"
          Description="Launch and respond security fixture" BackgroundColor="transparent"
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="targetedlaunch-response">
            <uap:DisplayName>TargetedLaunch matrix response</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
        <!-- ReturnResults is what makes this app discoverable through
             Launcher.FindUriSchemeHandlersAsync(scheme, LaunchQuerySupportType.UriForResults).
             "always" means this scheme can *only* be launched as a for-results request, so the
             app can never be started on it without a response contract in place. -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="targetedlaunch-forresults" ReturnResults="always">
            <uap:DisplayName>TargetedLaunch for-results provider</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
